; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GarageGame"
run/main_scene="res://world/garage_test.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
adjust_hold_distance={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":80)]
}
release_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
debug_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
save_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194333)]
}
load_game={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194340)]
}
reset_test_scene={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194339)]
}
primary_interact={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
secondary_interact={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
tighten={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
loosen={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="VehiclePart"
3d_physics/layer_3="Socket"
3d_physics/layer_4="Player"
3d_physics/layer_5="Tool"
3d_physics/layer_6="Vehicle"
3d_physics/layer_7="Fastener"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
